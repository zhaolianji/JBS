<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>商品详情页 - A69-2</title>
    <style>
        /* --- 基础样式 --- */
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 0; background-color: #f5f5f5; color: #333; }
        .container { max-width: 600px; margin: 0 auto; background-color: #fff; min-height: 100vh; box-shadow: 0 0 10px rgba(0,0,0,0.1); }

        /* --- 1. 顶部滑动图片区域 (核心部分) --- */
        .gallery-container {
            width: 100%;
            overflow-x: auto; /* 允许横向滚动 */
            scroll-snap-type: x mandatory; /* 强制吸附对齐 */
            display: flex; /* 让图片横排 */
            -webkit-overflow-scrolling: touch; /* iOS顺滑滚动 */
        }

        .gallery-item {
            flex: 0 0 100%; /* 每张图占满宽度 */
            scroll-snap-align: center; /* 滚动停止时居中 */
        }

        .gallery-item img {
            width: 100%;
            height: auto;
            display: block;
            aspect-ratio: 1/1; /* 强制正方形，防止长短不一 */
            object-fit: cover;
        }

        /* --- 2. 商品信息区域 --- */
        .product-info { padding: 20px; }
        .price-tag { color: #e4393c; font-size: 24px; font-weight: bold; margin-bottom: 10px; }
        .product-title { font-size: 18px; line-height: 1.4; margin-bottom: 15px; font-weight: 500; }

        /* --- 3. 详情表格样式 --- */
        .detail-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px; }
        .detail-table th, .detail-table td { border: 1px solid #eee; padding: 10px; text-align: left; }
        .detail-table th { background-color: #f9f9f9; color: #666; width: 80px; font-weight: normal; }
        .detail-table td { color: #333; }

        /* 底部购买按钮占位 */
        .footer-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 10px; border-top: 1px solid #eee; text-align: center; max-width: 600px; margin: 0 auto; }
        .buy-btn { background-color: #e4393c; color: #fff; border: none; padding: 12px 0; width: 100%; border-radius: 4px; font-size: 16px; cursor: pointer; }
    </style>
</head>
<body>

<div class="container">
    <!-- 图片滑动区域 -->
    <div class="gallery-container">
        <!-- 注意：这里的 src 路径必须和你 GitHub 仓库里的路径一致 -->
        <!-- 假设图片和 html 在同一个文件夹，或者你在 images 文件夹外 -->
        <div class="gallery-item"><img src="images/A69-2.jpg" alt="主图"></div>
        <div class="gallery-item"><img src="images/A69-2-1.jpg" alt="细节1"></div>
        <div class="gallery-item"><img src="images/A69-2-2.jpg" alt="细节2"></div>
        <div class="gallery-item"><img src="images/A69-2-3.jpg" alt="细节3"></div>
    </div>

    <!-- 商品信息 -->
    <div class="product-info">
        <div class="price-tag">¥1280</div>
        <div class="product-title">石玉料工艺老型单圈 (7mm/8mm | 28颗)</div>

        <!-- 详情表格 -->
        <table class="detail-table">
            <tr>
                <th>编号</th>
                <td>A69-2</td>
            </tr>
            <tr>
                <th>分类</th>
                <td>大类目：老型单圈 > 细分类目X > 2标准</td>
            </tr>
            <tr>
                <th>规格</th>
                <td>7mm/8mm | 28颗</td>
            </tr>
            <tr>
                <th>品相</th>
                <td>月留白均匀细星</td>
            </tr>
            <tr>
                <th>快递</th>
                <td>京东空运包邮</td>
            </tr>
            <tr>
                <th>备注</th>
                <td>无</td>
            </tr>
        </table>
    </div>

    <!-- 底部留白，防止内容被按钮遮挡 -->
    <div style="height: 60px;"></div>
</div>

<!-- 底部固定栏 -->
<div class="footer-bar">
    <button class="buy-btn">立即购买 / 咨询客服</button>
</div>

</body>
</html>
